# Example environment variables for Projek-SIBAL
# Copy this to a real `.env` file or set in your environment

# Google OAuth credentials (set these in your environment; do NOT commit real secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8051/auth/callback

# Flask secret
SECRET_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
